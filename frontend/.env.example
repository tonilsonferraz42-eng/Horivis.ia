# HORIVIS Frontend - Variáveis de Ambiente (Vite)
# Copia este ficheiro para .env e preenche os valores
# NUNCA commites o ficheiro .env

# Modelo Claude (proxy no backend)
VITE_ANTHROPIC_MODEL=claude-sonnet-5

# URL do backend (Railway em produção, localhost em dev)
VITE_API_URL=https://horivis-backend.railway.app

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=